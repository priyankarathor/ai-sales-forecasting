# Copy values into your existing local .env; do not commit credentials.
# Existing MongoDB routes still use MONGO_URL.
MONGO_URL=mongodb://localhost:27017

# Create a dedicated database named forecasting in local PostgreSQL first.
# URL-encode special characters in USER/PASSWORD (for example @ becomes %40).
FORECAST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/forecasting
